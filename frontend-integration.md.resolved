## 🎯 Public Quiz Access

### Get Public Quiz with Images

**Endpoint:** `GET /api/public/quiz/:token`

**Response:**
```json
{
  "success": true,
  "data": {
    "id": 1,
    "title": "IQ Test - Math & Language",
    "description": "Quiz description...",
    "questions": [
      {
        "id": 1,
        "questionText": "What is shown in the image?",
        "questionType": "multiple-choice",
        "options": ["A", "B", "C", "D"],
        "order": 1,
        "isMultipleAnswer": false,
        "images": [{
          "id": 1,
          "filePath": "http://localhost:3001/api/files/quiz-images%2F...",
          "originalName": "question1.png",
          "mimeType": "image/png",
          "fileSize": 12345
        }]
      }
    ]
  }
}
```

**Display in Quiz Taking Page:**
```tsx
const QuizTakingPage: React.FC = () => {
  const [quiz, setQuiz] = useState<any>(null);
  
  useEffect(() => {
    fetch(`/api/public/quiz/${token}`)
      .then(res => res.json())
      .then(data => setQuiz(data.data));
  }, [token]);
  
  return (
    <div>
      {quiz?.questions.map(question => (
        <div key={question.id} className="question-card">
          <p>{question.questionText}</p>
          
          {/* Display image if exists */}
          {question.images?.length > 0 && (
            <img 
              src={question.images[0].filePath}
              alt={question.images[0].altText}
              className="question-image"
            />
          )}
          
          {/* Answer options */}
          {question.options.map((opt, i) => (
            <label key={i}>
              <input type="radio" name={`q${question.id}`} value={opt} />
              {opt}
            </label>
          ))}
        </div>
      ))}
    </div>
  );
};
```

