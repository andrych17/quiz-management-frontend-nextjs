## 📥 Display Images

### 1. Get Question with Images

**Endpoint:** `GET /api/questions/:id`

**Response:**
```json
{
  "id": 1,
  "questionText": "Apa yang ditunjukkan gambar?",
  "images": [{
    "id": 1,
    "filePath": "http://localhost:3001/api/files/quiz-images%2F1705512345_abc123.png",
    "originalName": "diagram.png",
    "mimeType": "image/png",
    "fileSize": 45678,
    "altText": "Process diagram"
  }]
}
```

### 2. Display in React/Vue Component

**React Example:**
```tsx
interface QuestionImageProps {
  question: QuestionResponse;
}

const QuestionWithImage: React.FC<QuestionImageProps> = ({ question }) => {
  return (
    <div className="question">
      <h3>{question.questionText}</h3>
      
      {/* Display image jika ada */}
      {question.images && question.images.length > 0 && (
        <div className="question-image">
          <img 
            src={question.images[0].filePath}  {/* ← Gunakan filePath */}
            alt={question.images[0].altText || question.questionText}
            loading="lazy"
          />
        </div>
      )}
      
      {/* Display options */}
      <div className="options">
        {question.options.map((option, idx) => (
          <button key={idx}>{option}</button>
        ))}
      </div>
    </div>
  );
};
```

**Vue Example:**
```vue
<template>
  <div class="question">
    <h3>{{ question.questionText }}</h3>
    
    <!-- Display image jika ada -->
    <div v-if="question.images?.length" class="question-image">
      <img 
        :src="question.images[0].filePath"
        :alt="question.images[0].altText || question.questionText"
        loading="lazy"
      />
    </div>
    
    <!-- Display options -->
    <div class="options">
      <button v-for="(option, idx) in question.options" :key="idx">
        {{ option }}
      </button>
    </div>
  </div>
</template>
```

