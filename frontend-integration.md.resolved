## 📊 Quiz Results Display

Images akan otomatis muncul di quiz results karena sudah include di question data.

**Example Results Page:**
```tsx
const QuizResults: React.FC<{ attemptId: number }> = ({ attemptId }) => {
  const [results, setResults] = useState<any>(null);
  
  // Fetch results akan include questions dengan images
  useEffect(() => {
    fetch(`/api/attempts/${attemptId}`)
      .then(res => res.json())
      .then(data => setResults(data));
  }, [attemptId]);
  
  return (
    <div>
      {results?.answers.map((answer: any) => {
        const question = answer.question;
        const isCorrect = answer.isCorrect;
        
        return (
          <div key={question.id} className={isCorrect ? 'correct' : 'wrong'}>
            <p>{question.questionText}</p>
            
            {/* Show image in results */}
            {question.images?.length > 0 && (
              <img src={question.images[0].filePath} alt="Question" />
            )}
            
            <p>Your answer: {answer.userAnswer}</p>
            <p>Correct answer: {question.correctAnswer}</p>
          </div>
        );
      })}
    </div>
  );
};
```

